---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Services" 
  description="Quality improvement consulting, software development, and training services"
>
  <section class="hero" style="min-height: 50vh;">
    <div class="hero-content">
      <h1>Services</h1>
      <p class="tagline">Transforming Healthcare Through Innovation</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid">
        <div class="card">
          <div class="card-icon">📊</div>
          <h3>Quality Improvement Consulting</h3>
          <p>
            Comprehensive healthcare quality improvement services drawing from extensive experience 
            leading initiatives like the Mortality Coalition at UVA Health System.
          </p>
          <ul style="margin-top: 1rem; padding-left: 1.5rem; color: var(--text-light);">
            <li>Mortality and morbidity review processes</li>
            <li>Patient safety program development</li>
            <li>Clinical pathway optimization</li>
            <li>Data-driven quality metrics</li>
            <li>Interdisciplinary team facilitation</li>
          </ul>
        </div>

        <div class="card">
          <div class="card-icon">💻</div>
          <h3>Software Development</h3>
          <p>
            Custom software solutions for healthcare, education, and productivity—from iOS apps 
            to web platforms and automation systems.
          </p>
          <ul style="margin-top: 1rem; padding-left: 1.5rem; color: var(--text-light);">
            <li>iOS app development (Swift/SwiftUI)</li>
            <li>Web application design and implementation</li>
            <li>Healthcare system integrations</li>
            <li>Workflow automation</li>
            <li>Database design and management</li>
          </ul>
        </div>

        <div class="card">
          <div class="card-icon">🎤</div>
          <h3>Training & Speaking</h3>
          <p>
            Engaging presentations and training programs on healthcare quality, wilderness medicine, 
            technology integration, and professional development.
          </p>
          <ul style="margin-top: 1rem; padding-left: 1.5rem; color: var(--text-light);">
            <li>Quality improvement methodology</li>
            <li>Wilderness medicine education (FAWM candidate)</li>
            <li>Clinical leadership development</li>
            <li>Technology adoption strategies</li>
            <li>Burnout prevention and wellness</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Current Focus Areas</h2>
      </div>
      
      <div style="max-width: 800px; margin: 0 auto;">
        <div class="project-card" style="margin-bottom: 2rem;">
          <div class="project-content">
            <span class="project-tag">Healthcare Systems</span>
            <h3>Faculty Scheduling & Workforce Management</h3>
            <p>
              Developing sophisticated scheduling systems with point-based bidding, automated 
              conflict resolution, and equitable time-off allocation for academic medical centers.
            </p>
          </div>
        </div>

        <div class="project-card" style="margin-bottom: 2rem;">
          <div class="project-content">
            <span class="project-tag">Mobile Health</span>
            <h3>Health Tracking Applications</h3>
            <p>
              Creating intuitive iOS apps for longevity optimization, Long COVID management, and 
              comprehensive health data tracking with actionable insights.
            </p>
          </div>
        </div>

        <div class="project-card">
          <div class="project-content">
            <span class="project-tag">Wellness & Recovery</span>
            <h3>Burnout Prevention Programs</h3>
            <p>
              Developing frameworks and tools to help professionals recognize, address, and recover 
              from burnout while rediscovering purpose and joy in their work.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Let's Work Together</h2>
        <p>
          Interested in collaborating? Whether you need consulting, development, or speaking services, 
          I'm here to help solve your challenges.
        </p>
      </div>
      <div style="text-align: center; margin-top: 2rem;">
        <a href="/contact" class="btn btn-primary">Start a Conversation</a>
      </div>
    </div>
  </section>
</BaseLayout>
