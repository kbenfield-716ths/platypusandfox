---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Projects" 
  description="Software development, leadership programs, and wellness initiatives"
>
  <section class="hero" style="min-height: 50vh;">
    <div class="hero-content">
      <h1>Projects</h1>
      <p class="tagline">Building Solutions That Matter</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="projects-grid">
        
        <!-- Stronger Together -->
        <div class="project-card" id="stronger-together">
          <div class="project-header">
            <span class="project-category">Leadership Development</span>
            <h3>Stronger Together</h3>
          </div>
          <div class="project-body">
            <p class="project-summary">
              A 2.5-day immersive physician leadership program using sweep rowing as an experiential 
              learning tool for team building and high-performance leadership.
            </p>
            <div class="project-details">
              <h4>What It Is</h4>
              <p>
                Developed in partnership with the Darden School and Team Concepts, Stronger Together 
                addresses the critical need for leadership development in high-pressure healthcare 
                environments. Participants experience firsthand what it means to move as one team 
                through the physical challenge of rowing.
              </p>
              <h4>Key Features</h4>
              <ul>
                <li>Classroom sessions on high-performing teams and learning under pressure</li>
                <li>Hands-on rowing experience with professional coaching</li>
                <li>Insights diagnostic for understanding personal strengths under stress</li>
                <li>Culminating regatta where teams apply their learning</li>
                <li>Quarterly "boathouse time" follow-ups to maintain momentum</li>
              </ul>
              <h4>Impact</h4>
              <p>
                Pilot participants reported dramatic improvements in leadership engagement and 
                reduced feelings of isolation. With only 8 hours of coaching, three eight-person 
                boats successfully raced 500 meters with all rowers engaged—demonstrating the 
                power of focused leadership development.
              </p>
            </div>
          </div>
          <div class="project-footer">
            <span class="project-status">Pilot completed • Available for custom cohorts</span>
            <a href="/contact" class="project-link">Inquire About This Program →</a>
          </div>
        </div>

        <!-- FacultyHub / Faculty Scheduling System -->
        <div class="project-card" id="facultyhub">
          <div class="project-header">
            <span class="project-category">Healthcare Operations</span>
            <h3>FacultyHub</h3>
          </div>
          <div class="project-body">
            <p class="project-summary">
              An automated scheduling platform for academic medical centers featuring point-based 
              bidding, conflict resolution, and equitable time-off allocation.
            </p>
            <div class="project-details">
              <h4>What It Is</h4>
              <p>
                FacultyHub solves the complex scheduling challenges faced by academic medical 
                centers where faculty balance clinical duties, teaching, and research. The system 
                uses sophisticated algorithms to create fair, efficient schedules while respecting 
                individual preferences and institutional needs.
              </p>
              <h4>Key Features</h4>
              <ul>
                <li>Point-based bidding system for time-off requests</li>
                <li>Automated conflict detection and resolution</li>
                <li>Equitable distribution of desirable and undesirable shifts</li>
                <li>Integration with clinical operations systems</li>
                <li>Real-time schedule adjustments and notifications</li>
              </ul>
              <h4>Impact</h4>
              <p>
                Currently deployed at UVA Health Division of Pulmonary and Critical Care Medicine, 
                FacultyHub has streamlined scheduling for complex clinical operations while 
                improving faculty satisfaction and reducing administrative burden.
              </p>
            </div>
          </div>
          <div class="project-footer">
            <span class="project-status">Deployed at UVA Health</span>
            <a href="/contact" class="project-link">Request a Demo →</a>
          </div>
        </div>

        <!-- JamboHub -->
        <div class="project-card" id="jambohub">
          <div class="project-header">
            <span class="project-category">Event Management</span>
            <h3>JamboHub</h3>
          </div>
          <div class="project-body">
            <p class="project-summary">
              A communication and coordination platform designed specifically for large-scale 
              Scout events like National Jamborees.
            </p>
            <div class="project-details">
              <h4>What It Is</h4>
              <p>
                Managing logistics for thousands of participants across multiple locations requires 
                robust communication tools. JamboHub provides a centralized platform for schedules, 
                announcements, emergency communications, and participant tracking.
              </p>
              <h4>Key Features</h4>
              <ul>
                <li>Real-time schedule updates and notifications</li>
                <li>Location-based announcements and alerts</li>
                <li>Participant check-in and tracking</li>
                <li>Resource allocation and logistics management</li>
                <li>Multi-role access (leaders, staff, participants)</li>
              </ul>
              <h4>Vision</h4>
              <p>
                Drawing from years of Scouting leadership experience, JamboHub aims to solve the 
                communication challenges unique to large outdoor events where traditional tools fall short.
              </p>
            </div>
          </div>
          <div class="project-footer">
            <span class="project-status">Concept development</span>
            <a href="/contact" class="project-link">Learn More →</a>
          </div>
        </div>

        <!-- LongevityLab -->
        <div class="project-card" id="longevitylab">
          <div class="project-header">
            <span class="project-category">Health Technology</span>
            <h3>LongevityLab</h3>
          </div>
          <div class="project-body">
            <p class="project-summary">
              A comprehensive health tracking application for longevity optimization and 
              Long COVID management.
            </p>
            <div class="project-details">
              <h4>What It Is</h4>
              <p>
                LongevityLab brings together biomarker tracking, symptom monitoring, and 
                lifestyle interventions in one intuitive iOS app. Designed for people serious 
                about optimizing their health span or managing post-COVID symptoms.
              </p>
              <h4>Key Features</h4>
              <ul>
                <li>Comprehensive biomarker and vital sign tracking</li>
                <li>Symptom pattern recognition and analysis</li>
                <li>Lifestyle intervention recommendations</li>
                <li>Data visualization and trend analysis</li>
                <li>Integration with health data sources</li>
              </ul>
              <h4>Approach</h4>
              <p>
                Combines clinical medicine expertise with user-centered design to make complex 
                health data actionable and meaningful for individuals taking control of their health.
              </p>
            </div>
          </div>
          <div class="project-footer">
            <span class="project-status">In active development</span>
            <a href="/contact" class="project-link">Stay Updated →</a>
          </div>
        </div>

        <!-- College Activity Tracker -->
        <div class="project-card" id="college-activity-tracker">
          <div class="project-header">
            <span class="project-category">Education</span>
            <h3>College Activity Tracker</h3>
          </div>
          <div class="project-body">
            <p class="project-summary">
              A streamlined app for high school students to organize extracurricular activities, 
              leadership roles, and achievements for college applications.
            </p>
            <div class="project-details">
              <h4>What It Is</h4>
              <p>
                College applications require documenting years of activities, awards, and 
                experiences. This iOS app makes it easy to capture and organize everything as 
                it happens, eliminating the stress of trying to remember details years later.
              </p>
              <h4>Key Features</h4>
              <ul>
                <li>Activity logging with dates, roles, and descriptions</li>
                <li>Award and achievement tracking</li>
                <li>Volunteer hour documentation</li>
                <li>Export to Common App and other formats</li>
                <li>Reminder system for capturing ongoing activities</li>
              </ul>
              <h4>Goal</h4>
              <p>
                Help students maintain a complete, accurate record of their high school 
                achievements without the last-minute scramble when application season arrives.
              </p>
            </div>
          </div>
          <div class="project-footer">
            <span class="project-status">In active development</span>
            <a href="/contact" class="project-link">Learn More →</a>
          </div>
        </div>

        <!-- The Rekindling Project -->
        <div class="project-card" id="rekindling">
          <div class="project-header">
            <span class="project-category">Wellness & Recovery</span>
            <h3>The Rekindling Project</h3>
          </div>
          <div class="project-body">
            <p class="project-summary">
              Moving beyond burnout to rediscover purpose, joy, and sustainable practice in 
              healthcare and beyond.
            </p>
            <div class="project-details">
              <h4>What It Is</h4>
              <p>
                The Rekindling Project emerged from personal experience with burnout and the 
                realization that recovery isn't about becoming more efficient—it's about 
                rediscovering what makes work meaningful. This initiative focuses on helping 
                professionals rekindle the spark that drew them to their calling in the first place.
              </p>
              <h4>Core Themes</h4>
              <ul>
                <li><strong>Balance (Lagom):</strong> Finding sustainable rhythms in life and work</li>
                <li><strong>Boundaries:</strong> Learning to say "no" and protect what matters</li>
                <li><strong>Joy Over Utility:</strong> Valuing experiences for their own sake</li>
                <li><strong>Intentional Living:</strong> Making choices aligned with values</li>
                <li><strong>Community:</strong> Building supportive networks and authentic connections</li>
              </ul>
              <h4>Resources</h4>
              <p>
                Reflective writing on Substack bridges medical practice, wilderness wisdom, and 
                personal transformation, combining practical insights with deeper questions about 
                purpose and wellbeing.
              </p>
            </div>
          </div>
          <div class="project-footer">
            <span class="project-status">Ongoing</span>
            <a href="/writing" class="project-link">Read My Writing →</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="section" style="background-color: var(--light-gray);">
    <div class="container">
      <div class="section-header">
        <h2>Collaborate on a Project</h2>
        <p>
          Have an idea for a project or want to learn more about any of these initiatives? 
          I'm always interested in meaningful collaborations.
        </p>
      </div>
      <div style="text-align: center; margin-top: 2rem;">
        <a href="/contact" class="btn btn-primary">Get in Touch</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .projects-grid {
    display: grid;
    gap: 2.5rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .project-card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    border-left: 4px solid var(--primary-green);
    transition: all 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    border-left-color: var(--primary-orange);
  }

  .project-header {
    padding: 2rem 2rem 1rem;
    border-bottom: 1px solid var(--light-gray);
  }

  .project-category {
    display: inline-block;
    background: var(--light-green);
    color: white;
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 1rem;
  }

  .project-header h3 {
    font-size: 2rem;
    color: var(--text-dark);
    margin: 0;
  }

  .project-body {
    padding: 2rem;
  }

  .project-summary {
    font-size: 1.1rem;
    color: var(--text-dark);
    font-weight: 500;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .project-details h4 {
    color: var(--primary-green);
    font-size: 1.1rem;
    margin: 1.5rem 0 0.75rem;
  }

  .project-details h4:first-child {
    margin-top: 0;
  }

  .project-details p {
    color: var(--text-light);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .project-details ul {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0;
  }

  .project-details ul li {
    color: var(--text-light);
    line-height: 1.8;
    padding-left: 1.5rem;
    position: relative;
    margin-bottom: 0.5rem;
  }

  .project-details ul li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--primary-orange);
    font-weight: bold;
  }

  .project-footer {
    padding: 1.5rem 2rem;
    background: var(--light-gray);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .project-status {
    color: var(--text-light);
    font-size: 0.9rem;
    font-style: italic;
  }

  .project-link {
    color: var(--primary-orange);
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .project-link:hover {
    color: var(--primary-green);
    transform: translateX(5px);
  }

  @media (max-width: 768px) {
    .project-header {
      padding: 1.5rem 1.5rem 1rem;
    }

    .project-body {
      padding: 1.5rem;
    }

    .project-footer {
      padding: 1.25rem 1.5rem;
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
