---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home">
  <section class="hero">
    <div class="hero-content">
      <h1>Augmented Problem Solving</h1>
      <p class="tagline">Where Human Creativity Meets AI Capability</p>
      <p class="subtext">
        Leveraging decades of clinical experience and technical expertise to solve complex problems 
        in healthcare quality improvement, training, and software development.
      </p>
      <div class="cta-buttons">
        <a href="/services" class="btn btn-primary">Explore Services</a>
        <a href="/projects" class="btn btn-secondary">View Projects</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>About Platypus & Fox</h2>
        <p>
          Like the platypus—a unique combination of traits that shouldn't work together but do—I bring 
          together medicine, technology, leadership, and creativity. Like the fox, I focus on solving 
          one problem at a time with precision and strategy.
        </p>
      </div>
      
      <div class="card-grid">
        <div class="card">
          <div class="card-icon">🏥</div>
          <h3>Clinical Excellence</h3>
          <p>
            Board-certified in Pulmonary and Critical Care Medicine with extensive experience in 
            quality improvement, patient safety, and healthcare systems optimization.
          </p>
        </div>
        
        <div class="card">
          <div class="card-icon">💻</div>
          <h3>Technical Innovation</h3>
          <p>
            Building practical software solutions for healthcare, education, and productivity. 
            From iOS apps to web platforms, I create tools that solve real problems.
          </p>
        </div>
        
        <div class="card">
          <div class="card-icon">🎯</div>
          <h3>Strategic Leadership</h3>
          <p>
            Leading quality improvement initiatives, developing faculty systems, and managing 
            complex projects at the intersection of medicine and technology.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>The Augmented Approach</h2>
        <p>
          I don't believe AI replaces human creativity—it amplifies it. My work combines:
        </p>
      </div>
      
      <div class="card-grid">
        <div class="card">
          <h3>Human Insight</h3>
          <p>
            Pattern recognition from years of clinical practice, understanding of complex systems, 
            and the ability to ask the right questions.
          </p>
        </div>
        
        <div class="card">
          <h3>AI Acceleration</h3>
          <p>
            Using AI tools to handle repetitive tasks, explore possibilities faster, and implement 
            solutions more efficiently.
          </p>
        </div>
        
        <div class="card">
          <h3>Practical Solutions</h3>
          <p>
            Delivering results that work in the real world—tested, refined, and ready to deploy.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Ready to Work Together?</h2>
        <p>
          Whether you need healthcare consulting, software development, or training and speaking 
          services, let's explore how we can solve your challenges.
        </p>
      </div>
      <div style="text-align: center; margin-top: 2rem;">
        <a href="/contact" class="btn btn-primary">Get in Touch</a>
      </div>
    </div>
  </section>
</BaseLayout>
