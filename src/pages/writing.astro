---
import BaseLayout from "../layouts/BaseLayout.astro";
import Parser from "rss-parser";

const parser = new Parser();

const FEEDS = [
  { label: "Healthspan Lab", type: "Substack", url: "https://healthspanlab.substack.com/feed" },
  { label: "By Campfire and Candlelight", type: "Substack", url: "https://kbe716ths.substack.com/feed" },
  {
    label: "Publications (PubMed RSS)",
    type: "PubMed",
    url: "https://pubmed.ncbi.nlm.nih.gov/rss/search/1RwSy84-6Ztr-eeqbigUAL6oO8zFVead0wPzCxnfyBMdA7aAVM/?limit=10&utm_campaign=pubmed-2&fc=20260102170310",
  },
];

async function loadFeed(feed: { label: string; type: string; url: string }) {
  let items: any[] = [];
  try {
    const res = await fetch(feed.url);
    const xml = await res.text();
    const parsed = await parser.parseString(xml);
    items = parsed.items ?? [];
  } catch (e) {
    items = []; // swallow errors so build doesn’t fail
  }

  return items.map((item: any) => ({
    source: feed.label,
    type: feed.type,
    title: item.title ?? "(untitled)",
    link: item.link ?? "",
    date: item.isoDate ?? item.pubDate ?? "",
    excerpt: item.contentSnippet ?? item.summary ?? "",
  }));
}

const results = await Promise.all(FEEDS.map(loadFeed));
const all = results.flat();

const posts = all
  .filter((p) => p.link)
  .sort((a, b) => new Date(b.date || 0).getTime() - new Date(a.date || 0).getTime())
  .slice(0, 12);
