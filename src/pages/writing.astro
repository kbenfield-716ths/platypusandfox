---
import BaseLayout from '../layouts/BaseLayout.astro';
import Parser from 'rss-parser';

const parser = new Parser();

// Substack feeds via RSS2JSON proxy (handles 403 errors)
const SUBSTACKS = [
  {
    label: "Healthspan Lab",
    url: "https://api.rss2json.com/v1/api.json?rss_url=https://healthspanlab.substack.com/feed",
  },
  {
    label: "By Campfire and Candlelight",
    url: "https://api.rss2json.com/v1/api.json?rss_url=https://kbe716ths.substack.com/feed",
  },
];

// PubMed - can use direct RSS
const PUBMED = {
  label: "Publications (PubMed)",
  url: "https://pubmed.ncbi.nlm.nih.gov/rss/search/1RwSy84-6Ztr-eeqbigUAL6oO8zFVead0wPzCxnfyBMdA7aAVM/?limit=10&utm_campaign=pubmed-2&fc=20260102170310",
};

// Configuration for balancing sources
const MAX_PUBMED = 4;        // Limit PubMed articles
const MAX_PER_SUBSTACK = 10; // Max per Substack feed
const TOTAL_POSTS = 12;      // Total posts to display
const EXCERPT_LENGTH = 300;  // Characters for Substack excerpts

// Helper to strip HTML and get clean excerpt
function getExcerpt(html: string, maxLength: number = EXCERPT_LENGTH): string {
  if (!html) return "";
  
  // Strip HTML tags
  let text = html.replace(/<[^>]*>/g, ' ');
  
  // Decode common HTML entities
  text = text
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'");
  
  // Collapse whitespace
  text = text.replace(/\s+/g, ' ').trim();
  
  // Truncate to max length at word boundary
  if (text.length > maxLength) {
    text = text.substring(0, maxLength);
    const lastSpace = text.lastIndexOf(' ');
    if (lastSpace > 0) {
      text = text.substring(0, lastSpace);
    }
    text += '...';
  }
  
  return text;
}

// Load Substack feed via RSS2JSON
async function loadSubstackFeed(config: { label: string; url: string }) {
  try {
    const response = await fetch(config.url);
    
    if (!response.ok) {
      console.warn(`[RSS2JSON] ${config.label} -> HTTP ${response.status}`);
      return [];
    }
    
    const data = await response.json();
    
    if (data.status !== 'ok') {
      console.warn(`[RSS2JSON] ${config.label} -> ${data.status}`);
      return [];
    }
    
    return (data.items || []).slice(0, MAX_PER_SUBSTACK).map((item: any) => ({
      source: config.label,
      type: "Substack",
      title: item.title || "(untitled)",
      link: item.link || item.guid || "",
      date: item.pubDate || "",
      excerpt: getExcerpt(item.description || item.content, EXCERPT_LENGTH),
    }));
  } catch (e: any) {
    console.warn(`[RSS2JSON] ${config.label} failed:`, e?.message ?? e);
    return [];
  }
}

// Load PubMed RSS (works directly)
async function loadPubMedFeed() {
  try {
    const feed = await parser.parseURL(PUBMED.url);
    
    return (feed.items || []).slice(0, MAX_PUBMED).map((item: any) => ({
      source: PUBMED.label,
      type: "PubMed",
      title: item.title || "(untitled)",
      link: item.link || "",
      date: item.isoDate || item.pubDate || "",
      excerpt: item.contentSnippet || item.summary || "",
    }));
  } catch (e: any) {
    console.warn(`[PubMed] failed:`, e?.message ?? e);
    return [];
  }
}

// Load all feeds
const substackResults = (await Promise.all(
  SUBSTACKS.map(loadSubstackFeed)
)).flat();

const pubmedResults = await loadPubMedFeed();

// Combine and sort by date, then limit total
const allPosts = [...substackResults, ...pubmedResults]
  .filter((p) => p.link)
  .sort((a, b) => {
    const dateA = new Date(a.date || 0).getTime();
    const dateB = new Date(b.date || 0).getTime();
    return dateB - dateA;
  });

// Take the most recent posts up to TOTAL_POSTS
const posts = allPosts.slice(0, TOTAL_POSTS);

// Count posts by type
const substackCount = posts.filter(p => p.type === "Substack").length;
const pubmedCount = posts.filter(p => p.type === "PubMed").length;

console.log(`[RSS] Loaded ${posts.length} posts (${substackCount} Substack, ${pubmedCount} PubMed)`);
---

<BaseLayout title="Writing" description="Recent posts and publications">
  <section class="hero" style="min-height: 40vh;">
    <div class="hero-content">
      <h1>Writing</h1>
      <p class="tagline">Recent posts and publications</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {posts.length === 0 ? (
        <div style="text-align: center; padding: 3rem 0;">
          <p style="color: var(--text-light); font-size: 1.1rem;">
            No posts found. Check build logs for errors.
          </p>
        </div>
      ) : (
        <div class="feed-grid">
          {posts.map((p) => (
            <article class={`feed-card ${p.type === 'Substack' ? 'substack-card' : 'pubmed-card'}`}>
              <div class="feed-meta">
                <span class="feed-source">{p.source}</span>
                <span class="feed-type">{p.type}</span>
              </div>

              <h3 class="feed-title">
                <a href={p.link} target="_blank" rel="noopener noreferrer">{p.title}</a>
              </h3>

              {p.date && (
                <time class="feed-date" datetime={p.date}>
                  {new Date(p.date).toLocaleDateString("en-US", { 
                    year: "numeric", 
                    month: "short", 
                    day: "numeric" 
                  })}
                </time>
              )}

              {p.excerpt && <p class="feed-excerpt">{p.excerpt}</p>}
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section" style="background-color: var(--light-gray);">
    <div class="container">
      <div style="max-width: 700px; margin: 0 auto; text-align: center;">
        <h2 style="margin-bottom: 1rem; color: var(--primary-green); font-size: 1.5rem;">Subscribe</h2>
        <p style="color: var(--text-light); margin-bottom: 2rem;">
          Get my latest writing delivered directly to your inbox.
        </p>
        <div class="cta-buttons">
          <a href="https://healthspanlab.substack.com" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Healthspan Lab</a>
          <a href="https://kbe716ths.substack.com" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">By Campfire and Candlelight</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .feed-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .feed-card {
    background: white;
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    border: 1px solid rgba(0, 0, 0, 0.06);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .feed-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
  }

  /* Different styling for Substack vs PubMed */
  .substack-card {
    border-left: 4px solid var(--primary-green);
  }

  .pubmed-card {
    border-left: 4px solid var(--primary-orange);
  }

  .feed-meta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
  }

  .feed-source {
    font-weight: 700;
    color: var(--primary-green);
  }

  .feed-type {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    background: var(--light-gray);
    color: var(--text-dark);
    font-size: 0.8rem;
  }

  .feed-title {
    margin: 0.5rem 0;
    font-size: 1.15rem;
    line-height: 1.4;
  }

  .feed-title a {
    color: var(--text-dark);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .feed-title a:hover {
    color: var(--primary-orange);
  }

  .feed-date {
    display: block;
    font-size: 0.9rem;
    color: var(--text-light);
    margin: 0.5rem 0 1rem;
  }

  .feed-excerpt {
    margin-top: auto;
    color: var(--text-light);
    line-height: 1.7;
    font-size: 0.95rem;
    flex-grow: 1;
  }

  /* Substack excerpts are longer, give them more space */
  .substack-card .feed-excerpt {
    font-size: 1rem;
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    .feed-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
