---
import BaseLayout from '../layouts/BaseLayout.astro';
import Parser from 'rss-parser';

const parser = new Parser({
  customFields: {
    item: ['content:encoded', 'contentSnippet'],
  },
});

// Your Substack feeds
const SUBSTACKS = [
  {
    label: "Healthspan Lab",
    url: "https://healthspanlab.substack.com/feed",
  },
  {
    label: "By Campfire and Candlelight",
    url: "https://kbe716ths.substack.com/feed",
  },
];

// PubMed RSS
const PUBMED = {
  label: "Publications (PubMed)",
  url: "https://pubmed.ncbi.nlm.nih.gov/rss/search/1RwSy84-6Ztr-eeqbigUAL6oO8zFVead0wPzCxnfyBMdA7aAVM/?limit=10&utm_campaign=pubmed-2&fc=20260102170310",
};

// Load a single RSS feed
async function loadFeed(feedConfig: { label: string; url: string }, type = "Substack") {
  try {
    const feed = await parser.parseURL(feedConfig.url);
    
    return (feed.items || []).slice(0, 10).map((item: any) => ({
      source: feedConfig.label,
      type: type,
      title: item.title || "(untitled)",
      link: item.link || "",
      date: item.isoDate || item.pubDate || "",
      excerpt: item.contentSnippet || item.summary || "",
    }));
  } catch (e: any) {
    console.warn(`[RSS] ${feedConfig.label} failed:`, e?.message ?? e);
    return [];
  }
}

// Load all feeds
const substackResults = (await Promise.all(
  SUBSTACKS.map(config => loadFeed(config, "Substack"))
)).flat();

const pubmedResults = await loadFeed(PUBMED, "PubMed");

// Combine and sort
const posts = [...substackResults, ...pubmedResults]
  .filter((p) => p.link)
  .sort((a, b) => {
    const dateA = new Date(a.date || 0).getTime();
    const dateB = new Date(b.date || 0).getTime();
    return dateB - dateA;
  })
  .slice(0, 12);
---

<BaseLayout title="Writing" description="Recent posts and publications">
  <section class="hero" style="min-height: 40vh;">
    <div class="hero-content">
      <h1>Writing</h1>
      <p class="tagline">Recent posts and publications</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {posts.length === 0 && (
        <p style="text-align: center; color: var(--text-light); padding: 3rem 0;">
          Loading posts...
        </p>
      )}
      
      <div class="feed-grid">
        {posts.map((p) => (
          <article class="feed-card">
            <div class="feed-meta">
              <span class="feed-source">{p.source}</span>
              <span class="feed-type">{p.type}</span>
            </div>

            <h3 class="feed-title">
              <a href={p.link} target="_blank" rel="noopener noreferrer">{p.title}</a>
            </h3>

            {p.date && (
              <time class="feed-date" datetime={p.date}>
                {new Date(p.date).toLocaleDateString("en-US", { 
                  year: "numeric", 
                  month: "short", 
                  day: "numeric" 
                })}
              </time>
            )}

            {p.excerpt && <p class="feed-excerpt">{p.excerpt}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background-color: var(--light-gray);">
    <div class="container">
      <div style="max-width: 700px; margin: 0 auto; text-align: center;">
        <h2 style="margin-bottom: 1rem; color: var(--primary-green); font-size: 1.5rem;">Subscribe</h2>
        <p style="color: var(--text-light); margin-bottom: 2rem;">
          Get my latest writing delivered directly to your inbox.
        </p>
        <div class="cta-buttons">
          <a href="https://healthspanlab.substack.com" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Healthspan Lab</a>
          <a href="https://kbe716ths.substack.com" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">By Campfire and Candlelight</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .feed-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .feed-card {
    background: white;
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    border: 1px solid rgba(0, 0, 0, 0.06);
    transition: all 0.3s ease;
  }

  .feed-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
  }

  .feed-meta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
  }

  .feed-source {
    font-weight: 700;
    color: var(--primary-green);
  }

  .feed-type {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    background: var(--light-gray);
    color: var(--text-dark);
    font-size: 0.8rem;
  }

  .feed-title {
    margin: 0.5rem 0;
    font-size: 1.15rem;
    line-height: 1.4;
  }

  .feed-title a {
    color: var(--text-dark);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .feed-title a:hover {
    color: var(--primary-orange);
  }

  .feed-date {
    display: block;
    font-size: 0.9rem;
    color: var(--text-light);
    margin: 0.5rem 0;
  }

  .feed-excerpt {
    margin-top: 0.75rem;
    color: var(--text-light);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .feed-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
