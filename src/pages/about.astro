---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="About" 
  description="K. B. Enfield, MD FSHEA FCCM - Epidemiology, Critical Care, Systems Thinker, Adventurer"
>
  <section class="hero" style="min-height: 50vh;">
    <div class="hero-content">
      <h1>Kyle (K.B.) Enfield</h1>
      <p class="tagline">MD, FSHEA, FCCM</p>
      <p style="font-size: 1.2rem; margin-top: 1rem; opacity: 0.95;">
        Epidemiology • Critical Care • Systems Thinker • Adventurer
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="max-width: 900px; margin: 0 auto;">
        <div class="about-intro">
          <p>
            I'm a physician, critical care specialist, and epidemiologist who believes in showing up 
            fully — at the bedside, in the boat, behind the mike, with my family, or on a trail. My 
            roots are in Oklahoma, but life has taken me far — through Sweden and Switzerland, across 
            the globe, and into deep conversations about how we care, lead, and live.
          </p>
          <p>
            I'm a systems thinker by training and temperament. I thrive at the intersection of 
            precision and presence — where data meets intuition, and where structured planning 
            supports real human lives. I'm also a husband and father, a Scout leader, a rower, and 
            a lifelong seeker of new adventures (and good music).
          </p>
          <p>
            My work explores how we sustain both science and spirit. I'm drawn to the quiet 
            disciplines: listening closely, learning constantly, and leading with clarity.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background-color: var(--light-gray);">
    <div class="container">
      <div style="max-width: 900px; margin: 0 auto;">
        <h2 style="text-align: center; margin-bottom: 2rem; color: var(--primary-green);">Current Work</h2>
        
        <div class="work-grid">
          <div class="work-card">
            <h3>Clinical Practice</h3>
            <p>
              Faculty member at UVA Division of Pulmonary and Critical Care Medicine, specializing 
              in critical care, epidemiology, and infection prevention. Board-certified in Pulmonary 
              and Critical Care Medicine with fellowship training in Hospital Epidemiology & Infection 
              Prevention.
            </p>
          </div>

          <div class="work-card">
            <h3>Quality Improvement</h3>
            <p>
              Leading initiatives in data visualization for quality improvement, ICU care bundle 
              implementation, and healthcare systems optimization. Currently implementing the EPIC 
              version of the SCCM A-F Bundle at UVA Health.
            </p>
          </div>

          <div class="work-card">
            <h3>Research & Innovation</h3>
            <p>
              Published work on quality improvement data visualization, infection control, and 
              critical care systems. Developing tools and workflows that bridge clinical practice 
              with technology and human-centered design.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="max-width: 900px; margin: 0 auto;">
        <h2 style="text-align: center; margin-bottom: 2rem; color: var(--primary-green);">Current Projects</h2>
        
        <div class="project-list">
          <div class="project-item">
            <h3>The Long Haul - Surviving with Long COVID</h3>
            <p>
              A book exploring the lived experience of managing Long COVID, combining medical 
              expertise with personal narrative to help others navigate this challenging journey.
            </p>
            <span class="project-status">In progress</span>
          </div>

          <div class="project-item">
            <h3>SCCM A-F Bundle Implementation</h3>
            <p>
              Leading implementation of the Society of Critical Care Medicine's A-F Bundle in 
              EPIC at UVA Health, bringing evidence-based ICU care protocols into clinical workflow.
            </p>
            <span class="project-status">Active at UVA Health</span>
          </div>

          <div class="project-item">
            <h3>SCCM Podcast</h3>
            <p>
              Volunteer host for the Society of Critical Care Medicine's podcast, facilitating 
              conversations with critical care providers about clinical practice, research, and 
              professional development.
            </p>
            <span class="project-status">Ongoing</span>
          </div>
        </div>

        <div style="margin-top: 3rem; text-align: center;">
          <a href="https://scholar.google.com" target="_blank" rel="noopener noreferrer" 
             class="text-link">View Publications on Google Scholar →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background-color: var(--light-gray);">
    <div class="container">
      <div style="max-width: 900px; margin: 0 auto;">
        <h2 style="text-align: center; margin-bottom: 2rem; color: var(--primary-green);">Writing & Reflection</h2>
        
        <div class="writing-section">
          <h3>By Campfire and Candlelight</h3>
          <p>
            My Substack where I write about reverence — a Scout Law virtue and a sacred orientation. 
            From my perspective, I explore the rituals and disciplines that shape integrity in both 
            life and work. Topics range from wilderness wisdom to healthcare leadership, from family 
            life to finding sustainable rhythms in demanding professions.
          </p>
          <div style="margin-top: 1.5rem;">
            <a href="https://kbe716ths.substack.com" target="_blank" rel="noopener noreferrer" 
               class="btn btn-primary">Read My Writing</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="max-width: 700px; margin: 0 auto; text-align: center;">
        <h2 style="margin-bottom: 1.5rem; color: var(--primary-green);">Connect with Me</h2>
        <p style="font-size: 1.1rem; margin-bottom: 2rem; color: var(--text-light);">
          I keep standing office hours for collaborators, learners, and fellow thinkers. 
          Let's talk about systems, science, or rowing through hard things.
        </p>
        <div class="cta-buttons">
          <a href="/contact" class="btn btn-primary">Get in Touch</a>
          <a href="/projects" class="btn btn-secondary">View Projects</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-intro {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--text-dark);
  }

  .about-intro p {
    margin-bottom: 1.5rem;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .work-card {
    background: white;
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  .work-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
  }

  .work-card h3 {
    color: var(--primary-green);
    margin-bottom: 1rem;
    font-size: 1.3rem;
  }

  .work-card p {
    color: var(--text-light);
    line-height: 1.7;
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .project-item {
    background: white;
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    border-left: 4px solid var(--primary-orange);
  }

  .project-item h3 {
    color: var(--text-dark);
    margin-bottom: 0.75rem;
    font-size: 1.4rem;
  }

  .project-item p {
    color: var(--text-light);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .project-status {
    display: inline-block;
    background: var(--light-gray);
    color: var(--text-light);
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-style: italic;
  }

  .text-link {
    color: var(--primary-orange);
    font-weight: 600;
    font-size: 1.1rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .text-link:hover {
    color: var(--primary-green);
  }

  .writing-section {
    background: white;
    padding: 2.5rem;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .writing-section h3 {
    color: var(--primary-green);
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .writing-section p {
    color: var(--text-light);
    line-height: 1.7;
    font-size: 1.05rem;
  }

  @media (max-width: 768px) {
    .work-grid {
      grid-template-columns: 1fr;
    }

    .about-intro {
      font-size: 1.05rem;
    }
  }
</style>
